<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- androidx.compose.ui:ui-test-manifest declares this host activity for
             Compose UI tests (createComposeRule()) but, in the pinned version,
             without a LAUNCHER intent-filter — Robolectric's shadow package
             manager refuses to resolve even an explicit-component launch
             Intent without one. Re-declared here (debug-only) with it added. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
